# Credenciais do MongoDB (usadas pelo Docker Compose para montar MONGO_URI)
MONGO_USER=admin
MONGO_PASSWORD=secret

# URI de conexão (injetada pelo Docker Compose no container da app)
# Para desenvolvimento local sem Docker, aponte para sua instância MongoDB
MONGO_URI=mongodb://admin:secret@localhost:27017/meubanco?authSource=admin

# Nome do banco de dados
DB_NAME=meubanco
